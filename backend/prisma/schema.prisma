generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUM DE TIPO DE TRANSAÇÃO
enum TipoTransacao {
  DEPOSITO
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
}

model Cliente {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(120)
  cpf        String   @unique @db.VarChar(14)
  email      String   @unique @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  contas conta[]

  @@map("cliente")
}

model conta {
  id         Int      @id @default(autoincrement())
  numero     String   @unique @db.VarChar(30)
  saldo      Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  cliente_id Int
  cliente    Cliente @relation(fields: [cliente_id], references: [id], map: "fk_conta_cliente")

  transacoes transacao[]

  @@index([cliente_id], map: "idx_conta_cliente_id")
}

model transacao {
  id         Int           @id @default(autoincrement())
  tipo       TipoTransacao
  valor      Decimal       @db.Decimal(12, 2)
  descricao  String?
  created_at DateTime      @default(now()) @db.Timestamptz(6)

  conta_id Int
  conta    conta @relation(fields: [conta_id], references: [id], map: "fk_transacao_conta")

  @@index([conta_id], map: "idx_transacao_conta_id")
  @@index([created_at], map: "idx_transacao_created_at")
}
